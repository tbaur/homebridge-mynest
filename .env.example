# Nest Account access token, used by the local verification script only.
#
# The plugin itself reads this value from the Homebridge platform config
# (`accessToken`), not from the environment. This file exists so `npm run
# verify` can talk to a live account without the token ever being typed into a
# shell history or committed.
#
# How to obtain it:
#   1. Sign in at https://home.nest.com in a browser.
#   2. In the same browser, open https://home.nest.com/session
#   3. Copy the value of the `access_token` field from the JSON response.
#
# The token grants full control of every thermostat and smoke alarm on the
# account. Treat it like a password: never commit it, never paste it into an
# issue report. Copy this file to `.env` (which is gitignored) to use it.
NEST_ACCESS_TOKEN=

# Optional. Set to 1 to talk to Nest's field-test environment
# (home.ft.nest.com / grpc-web.ft.nest.com) instead of production.
# NEST_FIELD_TEST=1

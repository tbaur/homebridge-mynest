# Google sign-in values, used by the local verification script only.
#
# The plugin itself reads these from the Homebridge platform config
# (`issueToken` and `cookies`), not from the environment. This file exists so
# `npm run verify` can talk to a live account without the values ever being
# typed into a shell history or committed.
#
# How to copy them: docs/AUTH.md. Paste each value on one line after the `=`.
#
# The cookies sign in to the whole Google account. Treat them like a password:
# never commit them, never paste them into an issue report. Copy this file to
# `.env` (which is gitignored) to use it.
NEST_ISSUE_TOKEN=
NEST_COOKIES=

# Optional. Set to 1 to talk to Nest's field-test environment
# (home.ft.nest.com / grpc-web.ft.nest.com) instead of production.
# NEST_FIELD_TEST=1

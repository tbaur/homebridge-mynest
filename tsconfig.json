{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // `node10` is the current spelling of the classic resolver, and TypeScript
    // 6 deprecates it — hence `ignoreDeprecations`. Migrating to `node16` is
    // blocked upstream, not by choice: it requires `module: node16`, under
    // which every `import type … from 'homebridge'` fails with TS1541 because
    // Homebridge is ESM-only and this package is CommonJS. Those imports erase
    // at compile time, so annotating eight of them with `resolution-mode` would
    // buy nothing. Revisit when the plugin can emit ESM.
    "moduleResolution": "node10",
    "types": ["node"],
    "ignoreDeprecations": "6.0",
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "coverage", "tests"]
}

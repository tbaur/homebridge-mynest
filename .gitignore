# Build
build/
*.tsbuildinfo
# Note: dist/ is NOT ignored - it's committed so `npm install <git-url>` works
# even if the `prepare` script is skipped (e.g. --ignore-scripts). `prepare`
# compiles from source on install, so the committed output is a fallback rather
# than the thing consumers are trusted to run; CI fails the build if it drifts.

# Environment
.env
.env.local
.env.*.local

# Probe output. A Nest access token grants full control of the home's
# thermostats and smoke alarms, and captured payloads carry structure IDs,
# room names, and device serials. Nothing from a live account is committed.
probe-output/


{
  "name": "homebridge-mynest",
  "displayName": "Homebridge My Nest",
  "version": "2.0.1",
  "description": "Homebridge plugin for Nest thermostats (with Eco Mode), Nest Protect, and Nest Temperature Sensors using a Nest Account access token",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "homebridge-plugin",
    "nest",
    "nest-thermostat",
    "nest-protect",
    "nest-eco",
    "thermostat",
    "smoke-detector",
    "temperature-sensor",
    "homekit"
  ],
  "author": {
    "name": "tbaur",
    "url": "https://github.com/tbaur"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tbaur/homebridge-mynest.git"
  },
  "bugs": {
    "url": "https://github.com/tbaur/homebridge-mynest/issues"
  },
  "homepage": "https://github.com/tbaur/homebridge-mynest#readme",
  "dependencies": {
    "protobufjs": "7.6.6"
  },
  "overrides": {
    "js-yaml": "3.15.1",
    "@homebridge/hap-nodejs": "$@homebridge/hap-nodejs"
  },
  "devDependencies": {
    "@homebridge/hap-nodejs": "^2.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "homebridge": "^2.1.0",
    "jest": "^30.4.2",
    "nock": "^14.0.16",
    "ts-jest": "29.4.12",
    "typescript": "6.0.3"
  },
  "engines": {
    "homebridge": "^2.0.0",
    "node": "^22 || ^24 || ^26"
  },
  "peerDependencies": {
    "homebridge": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "homebridge": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build",
    "verify": "npm run build && node scripts/verify.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "NODE_ENV=test jest --coverage",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:unit": "NODE_ENV=test jest --coverage --testPathPatterns=tests/unit",
    "test:integration": "NODE_ENV=test jest --testPathPatterns=tests/integration --collectCoverage=false",
    "test:detect-handles": "NODE_ENV=test jest --detectOpenHandles --forceExit=false --collectCoverage=false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "files": [
    "dist/**/*",
    "!dist/**/*.map",
    "assets/**/*",
    "config.schema.json",
    "CHANGELOG.md",
    "SECURITY.md",
    "README.md",
    "docs/**/*"
  ]
}
